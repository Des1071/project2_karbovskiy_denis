[0.534286, "o", "make project"]
[1.415903, "o", "\r\n\u001b[?2004l\r"]
[1.418295, "o", "poetry run project\r\n"]
[2.068301, "o", "\r\nДоброе пожаловать в примитивную базу данных!\r\n\r\n***\r\n<command> create_table <имя_таблицы> <столбец1:тип> <столбец2:тип> .. - создать таблицу.\r\n<command> drop_table <имя_таблицы> - удалить таблицу.\r\n<command> list_tables - показать список всех таблиц.\r\n<command> insert into <имя_таблицы> values (<значение1>, <значение2>, ...) - создать запись.\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию.\r\n<command> select from <имя_таблицы> - прочитать все записи.\r\n<command> update <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец_условия> = <значение_условия> - обновить запись.\r\n<command> delete from <имя_таблицы> where <столбец>"]
[2.068396, "o", " = <значение> - удалить запись.\r\n<command> info <имя_таблицы> - вывести информацию о таблице.\r\n<command> exit - выйти из программы.\r\n<command> help - справочная информация.\r\n\r\n\r\n"]
[2.068652, "o", "Введите команду: "]
[8.289023, "o", "list_tables"]
[9.157365, "o", "\r\n"]
[9.157586, "o", "- users"]
[9.158062, "o", "\r\n\r\n\r\nВведите команду: "]
